# Build context for packaging/docker/Dockerfile (context = repository root).

# Dependencies and build output: the image installs and builds its own.
**/node_modules
**/dist
**/*.tsbuildinfo
**/.vite
**/coverage
tools/consensus-verify/target

# Version control, editor and agent state
.git
.github
.claude
.vscode
.idea
**/.DS_Store

# Not needed to build the guardian image. Keeping them out also keeps the build
# input (and so the image) from changing when only these files change.
design
docs
site
tools
apps/mobile
packaging/umbrel
packaging/start9

# Secrets and local state: never let these reach the image
.env
.env.*
**/.env
**/.env.*
.trikey
**/.trikey
**/*.key
**/*.pem
**/*.p8
**/*.p12
**/secrets
**/wallet*.json
**/seed*.txt
**/*.log
