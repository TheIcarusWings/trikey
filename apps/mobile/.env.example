# Copy to .env (git-ignored) and fill in. Variables starting with EXPO_PUBLIC_ are compiled into
# the app and visible to anyone who has it. None of them is a secret, but each one belongs to
# whoever publishes the app: the values filled in here are the Trikey project's own, and a fork
# replaces them. Leave one empty and its feature switches off.
# Full steps: README.md, "Publishing your own build".

# Google Drive cloud backup (Android).
# The OAuth client ID of the "Web application" client in YOUR Google Cloud project. The same
# project needs an "Android" OAuth client with this app's package name and signing-key SHA-1,
# and the Google Drive API enabled. An OAuth client ID is not a secret.
# Unset: Google Drive backup reports itself unavailable.
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Passkeys (the backup's unlock key).
# A domain the publisher controls, as a bare host name: no https://, no path. The Trikey
# project's own builds use trikey.app; a fork must use its own domain.
# It must serve /.well-known/apple-app-site-association and /.well-known/assetlinks.json;
# the templates are in docs/passkeys.md. Also becomes the iOS associated domain.
# Unset: passkeys report themselves unsupported.
EXPO_PUBLIC_PASSKEY_RP_ID=trikey.app

# The settings below are read when the native project is generated (npx expo prebuild or a
# build), not by the running app. They are not EXPO_PUBLIC_, so they stay out of the bundle.

# Your app identifiers. Default to the ones in app.json, which belong to the Trikey project.
# TRIKEY_IOS_BUNDLE_ID=com.yourcompany.trikey
# TRIKEY_ANDROID_PACKAGE=com.yourcompany.trikey

# iCloud Drive container for the iOS cloud backup, created in the Apple Developer account.
# Defaults to iCloud.<bundle id>, i.e. iCloud.app.trikey.wallet for the project's own builds.
# TRIKEY_ICLOUD_CONTAINER=iCloud.com.yourcompany.trikey
# 'Development' while testing with development provisioning; the default is 'Production'.
# TRIKEY_ICLOUD_ENVIRONMENT=Production
# Build without iCloud (for example with a free Apple developer account, which cannot use it).
# TRIKEY_DISABLE_ICLOUD=1

# Your Apple Team ID, for signing.
# TRIKEY_APPLE_TEAM_ID=
