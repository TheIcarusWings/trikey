// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`recovery sheet: the page > is the same page for the same wallets and day (snapshot) 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trikey recovery sheet — every wallet</title>
<style>
@page { size: auto; margin: 12mm; }
* { box-sizing: border-box; }
html, body { margin: 0; background: #fff; color: #000; }
body { font: 10pt/1.4 -apple-system, "Helvetica Neue", Helvetica, Arial, sans-serif; padding: 16px; max-width: 190mm; margin: 0 auto; }
h1 { font-size: 19pt; margin: 0 0 2px; letter-spacing: -0.01em; }
h2 { font-size: 12pt; margin: 14px 0 6px; }
p { margin: 0 0 6px; }
.meta { font-size: 9.5pt; }
.mono { font-family: ui-monospace, Menlo, Consolas, "Courier New", monospace; }
.test, .demo { border: 2px solid #000; padding: 6px 10px; margin: 8px 0; font-weight: 700; }
.break { break-after: page; page-break-after: always; }
.wallet { border-top: 1px solid #000; padding-top: 4px; break-inside: avoid; page-break-inside: avoid; }
.top { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
.qr { max-width: 100%; flex: none; }
.qr svg { display: block; width: 100%; height: auto; }
.facts { flex: 1; min-width: 200px; }
.how { margin: 8px 0; padding-left: 18px; }
.how li { margin-bottom: 4px; }
table { width: 100%; border-collapse: collapse; font-size: 9pt; }
th, td { text-align: left; vertical-align: top; border-bottom: 1px solid #999; padding: 3px 6px 3px 0; }
th { font-weight: 600; white-space: nowrap; width: 32%; }
.brk, .code { word-break: break-all; }
.code { font-size: 8pt; border: 1px solid #999; padding: 6px; }
.small { font-size: 8.5pt; }
footer { margin-top: 12px; font-size: 8.5pt; border-top: 1px solid #000; padding-top: 6px; }
</style>
</head>
<body>
<header>
<h1>Trikey recovery sheet — every wallet</h1>
<p class="meta">Made 2026-11-05 · Network: Testnet · 2 wallets on one phone</p>
</header>

<p class="test">TEST NETWORK (Testnet). These wallets do not hold real bitcoin.</p>
<p class="note">One phone holds these wallets, each with its own hardware wallet. To recover one, follow the steps below with its code and its hardware wallet. The steps are the same for each.</p>
<ol class="how"><li><b>This sheet is not a key: nobody can move money with it.</b> It tells a new phone where this wallet's guardian lives.</li><li>If you lose this phone <b>and</b> its backup: install Trikey on a new phone, choose <i>I already have a Trikey wallet</i>, then <i>My phone and its backup</i>, and scan this code (or type the npub and relays below).</li><li>Approve on the wallet&#39;s hardware wallet. The guardian waits the security waiting period and tells your alert contacts, then moves the money to a new wallet of the new phone and the wallet&#39;s hardware wallet.</li><li>Lost the backup only? Make a new one from the phone instead. Lost the wallet&#39;s hardware wallet? Recover from this phone: you don't need this sheet.</li><li>Keep this sheet with the wallet&#39;s hardware wallet or with your papers. Don't keep it with any seed words.</li></ol>
<section class="wallet">
<h2>Main</h2>
<div class="top">
<div class="qr" style="width:38mm"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 65 65" shape-rendering="crispEdges" role="img"><title>Recovery code of Main</title><rect width="65" height="65" fill="#fff"/><path fill="#000" d="M4 4h7v1h-7zM14 4h3v1h-3zM18 4h1v1h-1zM20 4h1v1h-1zM22 4h2v1h-2zM26 4h4v1h-4zM31 4h1v1h-1zM34 4h2v1h-2zM40 4h1v1h-1zM45 4h3v1h-3zM49 4h3v1h-3zM54 4h7v1h-7zM4 5h1v1h-1zM10 5h1v1h-1zM13 5h5v1h-5zM19 5h1v1h-1zM24 5h1v1h-1zM30 5h4v1h-4zM37 5h3v1h-3zM41 5h1v1h-1zM43 5h1v1h-1zM45 5h1v1h-1zM47 5h1v1h-1zM49 5h1v1h-1zM51 5h1v1h-1zM54 5h1v1h-1zM60 5h1v1h-1zM4 6h1v1h-1zM6 6h3v1h-3zM10 6h1v1h-1zM12 6h2v1h-2zM15 6h1v1h-1zM18 6h1v1h-1zM21 6h4v1h-4zM27 6h3v1h-3zM32 6h1v1h-1zM34 6h1v1h-1zM43 6h4v1h-4zM48 6h4v1h-4zM54 6h1v1h-1zM56 6h3v1h-3zM60 6h1v1h-1zM4 7h1v1h-1zM6 7h3v1h-3zM10 7h1v1h-1zM12 7h1v1h-1zM15 7h1v1h-1zM17 7h1v1h-1zM21 7h1v1h-1zM24 7h1v1h-1zM27 7h1v1h-1zM29 7h1v1h-1zM33 7h4v1h-4zM39 7h3v1h-3zM45 7h3v1h-3zM49 7h1v1h-1zM51 7h1v1h-1zM54 7h1v1h-1zM56 7h3v1h-3zM60 7h1v1h-1zM4 8h1v1h-1zM6 8h3v1h-3zM10 8h1v1h-1zM12 8h1v1h-1zM14 8h1v1h-1zM19 8h1v1h-1zM22 8h1v1h-1zM26 8h3v1h-3zM30 8h5v1h-5zM36 8h1v1h-1zM39 8h1v1h-1zM43 8h2v1h-2zM46 8h1v1h-1zM48 8h1v1h-1zM51 8h1v1h-1zM54 8h1v1h-1zM56 8h3v1h-3zM60 8h1v1h-1zM4 9h1v1h-1zM10 9h1v1h-1zM12 9h1v1h-1zM15 9h3v1h-3zM19 9h4v1h-4zM26 9h3v1h-3zM30 9h1v1h-1zM34 9h3v1h-3zM38 9h1v1h-1zM40 9h1v1h-1zM42 9h1v1h-1zM44 9h2v1h-2zM47 9h1v1h-1zM50 9h1v1h-1zM54 9h1v1h-1zM60 9h1v1h-1zM4 10h7v1h-7zM12 10h1v1h-1zM14 10h1v1h-1zM16 10h1v1h-1zM18 10h1v1h-1zM20 10h1v1h-1zM22 10h1v1h-1zM24 10h1v1h-1zM26 10h1v1h-1zM28 10h1v1h-1zM30 10h1v1h-1zM32 10h1v1h-1zM34 10h1v1h-1zM36 10h1v1h-1zM38 10h1v1h-1zM40 10h1v1h-1zM42 10h1v1h-1zM44 10h1v1h-1zM46 10h1v1h-1zM48 10h1v1h-1zM50 10h1v1h-1zM52 10h1v1h-1zM54 10h7v1h-7zM12 11h2v1h-2zM15 11h1v1h-1zM17 11h1v1h-1zM20 11h2v1h-2zM23 11h4v1h-4zM28 11h3v1h-3zM34 11h4v1h-4zM39 11h1v1h-1zM41 11h4v1h-4zM46 11h1v1h-1zM48 11h1v1h-1zM50 11h1v1h-1zM4 12h1v1h-1zM6 12h5v1h-5zM14 12h4v1h-4zM20 12h3v1h-3zM26 12h1v1