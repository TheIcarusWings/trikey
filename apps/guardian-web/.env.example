# Which API implementation the UI talks to.
#   mock  in-memory demo data, no backend needed (default for `npm run dev`)
#   http  fetch against /api/... on the guardian (default for production builds)
VITE_API=mock

# Optional: prefix for every API request, when the UI is not served by the
# guardian itself. Leave empty to use same-origin /api/....
VITE_API_BASE=

# Build-time feature flag. "Host for someone" stays hidden (no page, no navigation entry)
# until the guardian API supports hosting; set to true to see the page against the mock.
VITE_FEATURE_HOST_FOR_SOMEONE=false

# Dev server only: where /api is proxied to when VITE_API=http.
GUARDIAN_API_PROXY=http://127.0.0.1:8787
