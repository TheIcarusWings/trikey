# Trikey Guardian settings for docker-compose.yml. Copy this file to .env (same folder) and fill it in.
# Lines starting with # are comments. No quotes around values. After a change: docker compose up -d
#
# .env holds your node's RPC password if you set one: keep it private, and never commit or share it.

# ---- Network --------------------------------------------------------------------------------------------------
# mainnet, testnet4, signet or regtest. Try signet or testnet4 first (no real money). Key 3 is made for this
# network: a guardian set up on signet cannot later switch to mainnet (set up a new one instead).
BITCOIN_NETWORK=signet

# ---- Where the guardian reads the blockchain --------------------------------------------------------------------
#   electrum   your own Electrum server (Electrs or Fulcrum): the ELECTRUM_* settings below. Best.
#   core       your own Bitcoin Core alone, no Electrum server: the BITCOIN_RPC_* settings below (README.md, "Bitcoin Core
#              alone"). The guardian keeps a watch-only wallet in it.
#   public     a public Electrum server: PUBLIC_ELECTRUM_SERVER. Only without a node: it sees your wallet's addresses and
#              this computer's IP address, and could hide coins or delay confirmations (it cannot spend or change rules).
# The guardian's web page can change this later (Settings, Server); that choice then wins over this file.
CHAIN_SOURCE=electrum

# ---- Your Electrum server (Electrs or Fulcrum), for CHAIN_SOURCE=electrum ----------------------------------------
# The host name or IP address of your Electrum server, as this computer reaches it. Examples:
#   192.168.1.20             a node on your network (Umbrel, Start9, RaspiBlitz, myNode, a NAS running Fulcrum)
#   host.docker.internal     a node on this same computer, outside Docker
#   electrs                  the node in this file (docker compose --profile node up -d)
#   mynode.tail1234.ts.net   a node you reach over Tailscale
ELECTRUM_HOST=192.168.1.20

# The Electrum port. Leave empty for the usual one: 50001, or 50002 with ELECTRUM_TLS=1.
ELECTRUM_PORT=

# 1: connect over TLS. Use it for a server on another machine (the guardian refuses plain TCP to anything that is
# not on this computer or your own network: 10.x, 172.16-31.x, 192.168.x, Tailscale's 100.64-127.x, fc00::/7).
ELECTRUM_TLS=0

# With ELECTRUM_TLS=1: the SHA-256 fingerprint of the server's own certificate, for the self-signed certificates
# Fulcrum and Electrs-behind-a-proxy make. The guardian then accepts exactly that certificate. Leave empty for a
# server with a certificate from a public CA. How to read it: README.md, "Electrum over TLS".
ELECTRUM_TLS_CERT_SHA256=

# 1 allows plain TCP to a server on the internet. Not advised: anyone on the way sees every address of your wallet.
ELECTRUM_ALLOW_PUBLIC_PLAINTEXT=0

# ---- A public server, for CHAIN_SOURCE=public ----------------------------------------------------------------------
# Empty: the first listed one for your network (README.md, "No node at all?"). Or a listed id (blockstream, emzy,
# lukechilds, bitaroo, blockstream-testnet, mempool-testnet4, mempool-signet), or host:port of another public server
# (always TLS). Its certificate pin, if it has a self-signed one:
PUBLIC_ELECTRUM_SERVER=
PUBLIC_ELECTRUM_CERT_SHA256=

# ---- Your Bitcoin Core (optional; needed for CHAIN_SOURCE=core) ------------------------------------------------
# With these four, the guardian also shows the node's sync progress, broadcasts through the node when Electrum
# fails, and scans for silent payments. Without them it works with the Electrum server alone. Same rules as above:
# Bitcoin Core's RPC has no TLS, so use it on your own network (or over Tailscale) only.
# For the node in this file (--profile node): BITCOIN_RPC_HOST=bitcoind, BITCOIN_RPC_PORT=8332, and choose a user
# name and a long random password here (letters and digits only, e.g. from: openssl rand -hex 24).
BITCOIN_RPC_HOST=
BITCOIN_RPC_PORT=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASS=
# 1 allows plain RPC to an address on the internet. Not advised: the password and your addresses cross it unencrypted.
BITCOIN_RPC_ALLOW_PUBLIC=0
# With CHAIN_SOURCE=core: the watch-only wallet's name in Bitcoin Core (default trikey-guardian).
BITCOIN_CORE_WALLET=

# ---- Web UI -----------------------------------------------------------------------------------------------------
# 127.0.0.1: only this computer opens the web UI (http://localhost:3000). On a NAS, 0.0.0.0 lets other computers
# open it: read README.md, "Opening the web UI from another computer" first (plain HTTP on your network).
TRIKEY_UI_BIND=127.0.0.1
TRIKEY_UI_PORT=3000

# ---- Optional ---------------------------------------------------------------------------------------------------
# The nostr relays the first-run screen offers, comma-separated (default: relay.damus.io, nos.lol, relay.primal.net).
TRIKEY_RELAYS=
# Worker threads for the silent payment scanner (default: one less than the CPU cores).
SP_SCAN_THREADS=
